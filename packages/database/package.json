{
  "name": "@daterra/database",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/types.ts"
  },
  "scripts": {
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:diff": "supabase db diff",
    "db:push": "supabase db push",
    "db:gen-types": "supabase gen types typescript --local > src/types.ts",
    "db:gen-types:remote": "supabase gen types typescript --linked > src/types.ts",
    "lint": "echo \"(no lint configured yet)\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.46.1"
  },
  "devDependencies": {
    "supabase": "^2.0.0",
    "typescript": "^5.7.0"
  }
}
